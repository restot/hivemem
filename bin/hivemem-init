#!/usr/bin/env bash
#
# hivemem-init — Bootstrap the hivemem development environment.
#
# Generates self-signed TLS certs, sets up auth token, and configures
# Claude Code's MCP endpoint. Safe to run multiple times (idempotent).
#
# Usage:
#   bin/hivemem-init [--hostname EXTRA_SAN]
#
# Options:
#   --hostname NAME   Add an extra SAN to the server certificate
#                     (in addition to localhost and 127.0.0.1)

set -euo pipefail

PROJECT_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
CERTS_DIR="$PROJECT_ROOT/certs"
ENV_FILE="$PROJECT_ROOT/.env"
ENV_EXAMPLE="$PROJECT_ROOT/.env.example"
CLAUDE_SETTINGS="$HOME/.claude/settings.local.json"
MCP_URL="https://localhost:3000/mcp"

EXTRA_HOSTNAME=""

# ---------------------------------------------------------------------------
# Parse arguments
# ---------------------------------------------------------------------------
while [[ $# -gt 0 ]]; do
  case "$1" in
    --hostname)
      EXTRA_HOSTNAME="$2"
      shift 2
      ;;
    *)
      echo "Unknown option: $1" >&2
      echo "Usage: bin/hivemem-init [--hostname EXTRA_SAN]" >&2
      exit 1
      ;;
  esac
done

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------
info()  { printf '\033[1;34m==>\033[0m %s\n' "$*"; }
ok()    { printf '\033[1;32m  ✓\033[0m %s\n' "$*"; }
skip()  { printf '\033[1;33m  –\033[0m %s (skipped, already exists)\n' "$*"; }

# ---------------------------------------------------------------------------
# 1. Generate self-signed TLS certificates
# ---------------------------------------------------------------------------
info "TLS certificates"

mkdir -p "$CERTS_DIR"

if [[ -f "$CERTS_DIR/hivemem-ca.pem" && -f "$CERTS_DIR/server.pem" ]]; then
  skip "Certs in $CERTS_DIR"
else
  # Build SAN list
  SAN="DNS:localhost,IP:127.0.0.1"
  if [[ -n "$EXTRA_HOSTNAME" ]]; then
    SAN="$SAN,DNS:$EXTRA_HOSTNAME"
  fi

  # --- CA key + cert ---
  openssl genrsa -out "$CERTS_DIR/hivemem-ca-key.pem" 4096 2>/dev/null
  openssl req -new -x509 -key "$CERTS_DIR/hivemem-ca-key.pem" \
    -sha256 -days 3650 \
    -subj "/CN=hivemem-ca/O=hivemem-dev" \
    -out "$CERTS_DIR/hivemem-ca.pem" 2>/dev/null
  ok "CA cert → certs/hivemem-ca.pem"

  # --- Server key + CSR + cert signed by CA ---
  openssl genrsa -out "$CERTS_DIR/server-key.pem" 2048 2>/dev/null

  openssl req -new -key "$CERTS_DIR/server-key.pem" \
    -subj "/CN=localhost/O=hivemem-dev" \
    -out "$CERTS_DIR/server.csr" 2>/dev/null

  openssl x509 -req -in "$CERTS_DIR/server.csr" \
    -CA "$CERTS_DIR/hivemem-ca.pem" \
    -CAkey "$CERTS_DIR/hivemem-ca-key.pem" \
    -CAcreateserial \
    -sha256 -days 825 \
    -extfile <(printf "subjectAltName=%s\nbasicConstraints=CA:FALSE\nkeyUsage=digitalSignature,keyEncipherment\nextendedKeyUsage=serverAuth" "$SAN") \
    -out "$CERTS_DIR/server.pem" 2>/dev/null
  ok "Server cert → certs/server.pem (SAN: $SAN)"

  # Clean up intermediate files
  rm -f "$CERTS_DIR/server.csr" "$CERTS_DIR/hivemem-ca.srl"
fi

# ---------------------------------------------------------------------------
# 2. Generate auth token and write .env
# ---------------------------------------------------------------------------
info "Auth token"

# Generate token (always, so we can set it in .env if missing)
TOKEN="$(openssl rand -hex 32)"

if [[ ! -f "$ENV_FILE" ]]; then
  if [[ -f "$ENV_EXAMPLE" ]]; then
    cp "$ENV_EXAMPLE" "$ENV_FILE"
    ok "Created .env from .env.example"
  else
    touch "$ENV_FILE"
    ok "Created empty .env"
  fi
fi

# Check if HIVEMEM_AUTH_TOKEN already has a non-empty value
EXISTING_TOKEN="$(grep -E '^HIVEMEM_AUTH_TOKEN=' "$ENV_FILE" 2>/dev/null | cut -d= -f2- || true)"

if [[ -n "$EXISTING_TOKEN" ]]; then
  TOKEN="$EXISTING_TOKEN"
  skip "HIVEMEM_AUTH_TOKEN already set in .env"
else
  # Replace the empty value or append
  if grep -qE '^HIVEMEM_AUTH_TOKEN=' "$ENV_FILE" 2>/dev/null; then
    # Line exists but value is empty — replace it
    if [[ "$(uname)" == "Darwin" ]]; then
      sed -i '' "s|^HIVEMEM_AUTH_TOKEN=.*|HIVEMEM_AUTH_TOKEN=$TOKEN|" "$ENV_FILE"
    else
      sed -i "s|^HIVEMEM_AUTH_TOKEN=.*|HIVEMEM_AUTH_TOKEN=$TOKEN|" "$ENV_FILE"
    fi
  else
    echo "HIVEMEM_AUTH_TOKEN=$TOKEN" >> "$ENV_FILE"
  fi
  ok "HIVEMEM_AUTH_TOKEN written to .env"
fi

# ---------------------------------------------------------------------------
# 3. Configure Claude Code MCP endpoint
# ---------------------------------------------------------------------------
info "Claude Code MCP config"

mkdir -p "$(dirname "$CLAUDE_SETTINGS")"

# Build the MCP server entry we want to merge in
MCP_ENTRY=$(python3 -c "
import json, sys

entry = {
    'type': 'url',
    'url': '$MCP_URL',
    'headers': {
        'Authorization': 'Bearer $TOKEN'
    }
}
print(json.dumps(entry))
")

if [[ -f "$CLAUDE_SETTINGS" ]]; then
  # Merge into existing settings, preserving everything else
  python3 -c "
import json, sys

with open('$CLAUDE_SETTINGS', 'r') as f:
    settings = json.load(f)

entry = json.loads('$MCP_ENTRY')
settings.setdefault('mcpServers', {})
settings['mcpServers']['hivemem'] = entry

with open('$CLAUDE_SETTINGS', 'w') as f:
    json.dump(settings, f, indent=2)
    f.write('\n')
"
  ok "Updated $CLAUDE_SETTINGS (merged hivemem into mcpServers)"
else
  python3 -c "
import json

settings = {
    'mcpServers': {
        'hivemem': json.loads('$MCP_ENTRY')
    }
}
with open('$CLAUDE_SETTINGS', 'w') as f:
    json.dump(settings, f, indent=2)
    f.write('\n')
"
  ok "Created $CLAUDE_SETTINGS with hivemem MCP config"
fi

# ---------------------------------------------------------------------------
# 4. Install hivemem skills (slash commands) from GitHub
# ---------------------------------------------------------------------------
info "Skills (slash commands)"

COMMANDS_REPO="${HIVEMEM_COMMANDS_REPO:-https://github.com/restot/hivemem.git}"
COMMANDS_BRANCH="${HIVEMEM_COMMANDS_BRANCH:-main}"
COMMANDS_PATH="${HIVEMEM_COMMANDS_PATH:-commands}"
COMMANDS_DST="$HOME/.claude/commands"

mkdir -p "$COMMANDS_DST"
{
  TMPDIR_COMMANDS="$(mktemp -d)"
  trap "rm -rf '$TMPDIR_COMMANDS'" EXIT

  git clone --depth 1 --branch "$COMMANDS_BRANCH" --filter=blob:none --sparse \
    "$COMMANDS_REPO" "$TMPDIR_COMMANDS" 2>/dev/null
  (cd "$TMPDIR_COMMANDS" && git sparse-checkout set "$COMMANDS_PATH" 2>/dev/null)

  for cmd in "$TMPDIR_COMMANDS/$COMMANDS_PATH"/hm-*.md; do
    [[ -f "$cmd" ]] || continue
    name="$(basename "$cmd")"
    if [[ -f "$COMMANDS_DST/$name" ]] && cmp -s "$cmd" "$COMMANDS_DST/$name"; then
      skip "$name"
    else
      cp "$cmd" "$COMMANDS_DST/$name"
      ok "$name → ~/.claude/commands/$name"
    fi
  done

  rm -rf "$TMPDIR_COMMANDS"
  trap - EXIT
}

# ---------------------------------------------------------------------------
# 5. Summary
# ---------------------------------------------------------------------------
echo ""
info "Setup complete"
echo ""
echo "  MCP endpoint:  $MCP_URL"
echo "  TLS certs:     $CERTS_DIR/"
echo "  Auth token:    .env (HIVEMEM_AUTH_TOKEN)"
echo "  Claude config: $CLAUDE_SETTINGS"
echo ""
echo "  To trust the CA on macOS (optional):"
echo "    sudo security add-trusted-cert -d -r trustRoot \\"
echo "      -k /Library/Keychains/System.keychain $CERTS_DIR/hivemem-ca.pem"
echo ""
